NEXT_PUBLIC_SUPABASE_URL=https://gnebcwgaahwowxwiqqlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Never expose a service role key to the browser or commit it to Git.

# Cloudinary server-side signed uploads. Never prefix the API secret with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
# Match this to the Cloudinary product environment folder mode: fixed or dynamic.
CLOUDINARY_FOLDER_MODE=dynamic
